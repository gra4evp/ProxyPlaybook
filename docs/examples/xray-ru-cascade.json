{
  "_comment": "RU server — client inbound + cascade outbound. Replace NL_SERVER_IP and secrets.",
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "tag": "in-443-tcp",
      "settings": {
        "clients": [{ "email": "client-ru", "id": "PHONE-CLIENT-UUID" }],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "target": "REALITY_DEST:443",
          "serverNames": ["REALITY_SNI"],
          "privateKey": "<REALITY_PRIVATE_KEY_RU>",
          "shortIds": ["SHORT_ID_RU"]
        },
        "xhttpSettings": { "host": "", "mode": "auto", "path": "/" }
      }
    }
  ],
  "outbounds": [
    { "protocol": "freedom", "tag": "direct" },
    { "protocol": "blackhole", "tag": "blocked" },
    {
      "protocol": "vless",
      "tag": "outbound-to-nl",
      "settings": {
        "address": "NL_SERVER_IP",
        "port": 443,
        "id": "BRIDGE-UUID",
        "encryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "fingerprint": "chrome",
          "publicKey": "<REALITY_PUBLIC_KEY_NL>",
          "serverName": "REALITY_SNI_NL",
          "shortId": "SHORT_ID_NL"
        },
        "xhttpSettings": { "mode": "auto", "path": "/" }
      }
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      { "type": "field", "inboundTag": ["api"], "outboundTag": "api" },
      {
        "type": "field",
        "domain": [
          "ext:geosite_RU.dat:ru-available-only-inside",
          "regexp:.*\\.ru$",
          "regexp:.*\\.su$",
          "regexp:.*\\.xn--p1ai$"
        ],
        "outboundTag": "direct"
      },
      { "type": "field", "ip": ["ext:geoip_RU.dat:ru"], "outboundTag": "direct" },
      { "type": "field", "network": "tcp,udp", "outboundTag": "outbound-to-nl" },
      { "type": "field", "ip": ["geoip:private"], "outboundTag": "blocked" },
      { "type": "field", "protocol": ["bittorrent"], "outboundTag": "blocked" }
    ]
  }
}
