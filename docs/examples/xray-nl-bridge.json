{
  "_comment": "Пример Xray config NL (138.124.2.114) — мост для RU. Секреты заменены на плейсхолдеры. Источник: /usr/local/x-ui/bin/config.json",
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "tag": "in-443-tcp",
      "settings": {
        "clients": [
          {
            "email": "admin-nl",
            "id": "BRIDGE-UUID-SAME-AS-RU-OUTBOUND"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "target": "www.cloudflare.com:443",
          "serverNames": ["blog.api.www.cloudflare.com", "www.cloudflare.com"],
          "privateKey": "<REALITY_PRIVATE_KEY_NL>",
          "shortIds": ["66eaa91a55", "1e0080af"]
        },
        "xhttpSettings": {
          "host": "",
          "mode": "auto",
          "path": "/"
        }
      }
    }
  ],
  "outbounds": [
    { "protocol": "freedom", "tag": "direct" },
    { "protocol": "blackhole", "tag": "blocked" }
  ],
  "routing": {
    "rules": [
      { "type": "field", "inboundTag": ["api"], "outboundTag": "api" },
      { "type": "field", "ip": ["geoip:private"], "outboundTag": "blocked" },
      { "type": "field", "protocol": ["bittorrent"], "outboundTag": "blocked" }
    ]
  }
}
